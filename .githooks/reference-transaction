#!/bin/sh
# Changes reach main only through pull requests (see CLAUDE.md). Turned on by `npm install`.
# Git runs this for every ref update, so it also catches what pre-commit cannot: merges (fast-forward or not), resets,
# rebases and `git branch -f`. The one move allowed is to exactly origin/main, which is the sync `git pull --ff-only`
# (or a reset back to origin/main). Needs Git 2.28 or later; older versions skip it, and pre-commit and pre-push remain.
# Git passes the state as $1 and one line per ref on stdin: <old value> <new value> <ref name>
[ "$1" = "prepared" ] || exit 0
while read -r old new ref; do
  [ "$ref" = "refs/heads/main" ] || continue
  upstream=$(git rev-parse -q --verify refs/remotes/origin/main)
  # Without a remote there is nothing to compare against, so leave main alone.
  if [ -z "$upstream" ] || [ "$new" = "$upstream" ]; then continue; fi
  # A merge or rebase has already changed the files by the time the ref update is refused, so say how to undo that.
  echo "main can only move to origin/main (git pull --ff-only). Work on a branch and open a pull request." >&2
  echo "  A refused merge leaves its changes in your files: undo them with git reset --merge (your own edits stay)." >&2
  echo "  A refused rebase stays in progress: undo it with git rebase --abort." >&2
  exit 1
done
exit 0
