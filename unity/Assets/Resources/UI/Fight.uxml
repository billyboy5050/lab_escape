<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Resources/UI/Fight.uss" />
    <ui:VisualElement name="root" class="root fill" picking-mode="Ignore">
        <ui:VisualElement name="vignette" class="vignette" picking-mode="Ignore" />
        <ui:VisualElement name="tags" class="fill" picking-mode="Ignore" />
        <ui:VisualElement name="flash-alarm" class="board-overlay flash alarm" picking-mode="Ignore" />
        <ui:VisualElement name="flash-hurt" class="board-overlay flash hurt" picking-mode="Ignore" />

        <ui:VisualElement class="fill layout" picking-mode="Ignore">
            <ui:VisualElement class="column-main" picking-mode="Ignore">
                <ui:VisualElement name="status" class="panel status">
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="HP" />
                        <ui:VisualElement name="hp-cells" class="cells" />
                        <ui:Label name="hp-text" class="value mono" />
                        <ui:VisualElement name="hp-pills" class="pills" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="AP" />
                        <ui:VisualElement name="ap-cells" class="cells" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="MOVE" />
                        <ui:VisualElement name="move-cells" class="cells" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="ROUND" />
                        <ui:Label name="round" class="value mono" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="PHASE" />
                        <ui:Label name="phase" class="value small display" />
                    </ui:VisualElement>
                    <ui:Label name="incoming" class="incoming display" />
                </ui:VisualElement>

                <ui:VisualElement name="board-area" class="board-area" picking-mode="Ignore">
                    <ui:Label name="banner" class="banner display hidden" picking-mode="Ignore" />
                    <ui:Label name="alert" class="banner alert display hidden" picking-mode="Ignore" />
                    <ui:VisualElement name="opener" class="opener hidden" picking-mode="Ignore">
                        <ui:Label name="opener-title" class="opener-title display" picking-mode="Ignore" />
                        <ui:VisualElement class="opener-rule" picking-mode="Ignore" />
                        <ui:Label name="opener-sub" class="opener-sub display" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="panel action-panel">
                    <ui:VisualElement name="action-row" class="action-row" />
                    <ui:VisualElement class="controls">
                        <ui:Button name="undo" class="btn" focusable="false"><ui:Label class="btn-text" text="Undo move" /><ui:Label class="kbd mono" text="Z" /></ui:Button>
                        <ui:Button name="end-turn" class="btn primary" focusable="false"><ui:Label class="btn-text" text="End turn" /><ui:Label class="kbd mono" text="E" /></ui:Button>
                        <ui:Button name="skip" class="btn hidden" focusable="false"><ui:Label class="btn-text" text="Skip" /><ui:Label class="kbd mono" text="Space" /></ui:Button>
                        <ui:Label name="hint" class="hint" />
                        <ui:Label class="control-label display" text="SPEED" /><ui:Label class="kbd mono key-before" text="F" />
                        <ui:VisualElement class="seg">
                            <ui:Button name="speed-1" class="seg-btn" text="1x" focusable="false" />
                            <ui:Button name="speed-2" class="seg-btn" text="2x" focusable="false" />
                            <ui:Button name="speed-0" class="seg-btn" text="Skip" focusable="false" />
                        </ui:VisualElement>
                        <ui:Button name="intents" class="btn" focusable="false"><ui:Label class="btn-text" text="Intents" /><ui:Label class="kbd mono" text="I" /></ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="column-side">
                <ui:VisualElement class="panel">
                    <ui:VisualElement class="panel-head">
                        <ui:VisualElement class="title-left"><ui:VisualElement class="led amber" /><ui:Label class="panel-title display" text="INTERCOM" /></ui:VisualElement>
                        <ui:Button name="open-log" class="btn small" focusable="false"><ui:Label class="btn-text" text="Log" /><ui:Label class="kbd mono" text="L" /></ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="intercom" class="intercom-text mono" />
                </ui:VisualElement>
                <ui:VisualElement class="panel">
                    <ui:VisualElement class="title-left"><ui:VisualElement class="led" /><ui:Label name="info-title" class="panel-title display" text="SCANNER" /></ui:VisualElement>
                    <ui:VisualElement name="info-body" class="info-body" />
                </ui:VisualElement>
                <ui:VisualElement class="panel">
                    <ui:VisualElement class="panel-head">
                        <ui:VisualElement class="title-left"><ui:VisualElement class="led" /><ui:Label class="panel-title display" text="MINIONS" /></ui:VisualElement>
                        <ui:Label name="minion-count" class="faint mono" />
                    </ui:VisualElement>
                    <ui:VisualElement name="minions" />
                </ui:VisualElement>
                <ui:VisualElement class="panel log-panel">
                    <ui:VisualElement class="title-left"><ui:VisualElement class="led" /><ui:Label class="panel-title display" text="COMBAT LOG" /></ui:VisualElement>
                    <ui:ScrollView name="log" class="log" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="toast" class="toast hidden" picking-mode="Ignore" />

        <ui:VisualElement name="start" class="fill overlay">
            <ui:VisualElement class="card">
                <ui:Label name="start-title" class="card-title display" />
                <ui:Label class="muted" text="Choose a loadout. Press its number, or click it." />
                <ui:VisualElement name="presets" class="presets" />
                <ui:Label name="start-error" class="warn hidden" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="end" class="fill overlay hidden" picking-mode="Ignore">
            <ui:VisualElement name="end-card" class="card">
                <ui:Label name="end-title" class="card-title display" />
                <ui:Label name="end-cause" class="muted" />
                <ui:VisualElement class="row">
                    <ui:Button name="again" class="btn primary" focusable="false"><ui:Label class="btn-text" text="Fight again" /><ui:Label class="kbd mono" text="R" /></ui:Button>
                    <ui:Button name="change" class="btn" text="Change loadout" focusable="false" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="log-modal" class="fill overlay hidden">
            <ui:VisualElement class="card wide">
                <ui:VisualElement class="panel-head">
                    <ui:Label class="card-title small display" text="TRANSMISSION LOG" />
                    <ui:Button name="close-log" class="btn small" focusable="false"><ui:Label class="btn-text" text="Close" /><ui:Label class="kbd mono" text="Esc" /></ui:Button>
                </ui:VisualElement>
                <ui:ScrollView name="log-lines" class="modal-lines" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
