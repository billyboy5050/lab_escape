<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Resources/UI/Fight.uss" />
    <ui:VisualElement name="root" class="root fill" picking-mode="Ignore">
        <ui:VisualElement name="vignette" class="vignette" picking-mode="Ignore" />
        <ui:VisualElement name="tags" class="fill" picking-mode="Ignore" />
        <ui:VisualElement name="flash-alarm" class="board-overlay flash alarm" picking-mode="Ignore" />
        <ui:VisualElement name="flash-hurt" class="board-overlay flash hurt" picking-mode="Ignore" />

        <ui:VisualElement class="fill layout" picking-mode="Ignore">
            <ui:VisualElement name="debug" class="column-debug hidden">
                <ui:VisualElement class="panel debug-panel">
                    <ui:VisualElement class="panel-head">
                        <ui:VisualElement class="title-left"><ui:VisualElement class="led amber" /><ui:Label class="panel-title display" text="DEBUG" /></ui:VisualElement>
                        <ui:Button name="debug-close" class="btn small" focusable="false"><ui:Label class="btn-text" text="Hide" /><ui:Label class="kbd mono" text="`" /></ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="debug-version" class="debug-version faint mono" />
                    <ui:Label name="debug-content" class="debug-content mono hidden" />
                    <ui:Label class="debug-section display" text="ON THE BOARD" />
                    <ui:VisualElement class="seg debug-toggles">
                        <ui:Button name="debug-ids" class="seg-btn" text="IDs" focusable="false" />
                        <ui:Button name="debug-spawns" class="seg-btn" text="Spawns" focusable="false" />
                        <ui:Button name="debug-hazards" class="seg-btn" text="Hazards" focusable="false" />
                        <ui:Button name="debug-flamer" class="seg-btn" text="Scores" focusable="false" />
                        <ui:Button name="debug-log" class="seg-btn" text="Log" focusable="false" />
                    </ui:VisualElement>
                    <ui:Label class="debug-section display" text="STEP-THROUGH" />
                    <ui:VisualElement class="debug-row">
                        <ui:Button name="debug-step" class="btn small" focusable="false"><ui:Label class="btn-text" text="Pause after each action" /></ui:Button>
                        <ui:Label name="debug-queued" class="faint mono debug-note" />
                    </ui:VisualElement>
                    <ui:VisualElement class="debug-row">
                        <ui:Button name="debug-next" class="btn small" focusable="false"><ui:Label class="btn-text" text="Next action" /><ui:Label class="kbd mono" text="N" /></ui:Button>
                        <ui:Button name="debug-next-phase" class="btn small" focusable="false"><ui:Label class="btn-text" text="Next phase" /><ui:Label class="kbd mono" text="Shift+N" /></ui:Button>
                    </ui:VisualElement>
                    <ui:Label class="debug-section display" text="EDIT STATE" />
                    <ui:Label class="faint mono debug-note" text="Each edit is a command, so it is in the saved fight." />
                    <ui:VisualElement class="debug-row">
                        <ui:Button name="edit-unit-prev" class="btn small step" text="&lt;" focusable="false" />
                        <ui:Label name="edit-unit" class="mono debug-value wide" />
                        <ui:Button name="edit-unit-next" class="btn small step" text="&gt;" focusable="false" />
                    </ui:VisualElement>
                    <ui:VisualElement class="debug-row">
                        <ui:Label class="faint mono debug-name" text="HP" />
                        <ui:Button name="edit-hp-down" class="btn small step" text="-" focusable="false" />
                        <ui:Label name="edit-hp" class="mono debug-value" />
                        <ui:Button name="edit-hp-up" class="btn small step" text="+" focusable="false" />
                        <ui:Button name="edit-set-hp" class="btn small" focusable="false"><ui:Label class="btn-text" text="Set HP" /></ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="debug-row">
                        <ui:Label class="faint mono debug-name" text="AP" />
                        <ui:Button name="edit-ap-down" class="btn small step" text="-" focusable="false" />
                        <ui:Label name="edit-ap" class="mono debug-value" />
                        <ui:Button name="edit-ap-up" class="btn small step" text="+" focusable="false" />
                        <ui:Label class="faint mono debug-name" text="Move" />
                        <ui:Button name="edit-move-down" class="btn small step" text="-" focusable="false" />
                        <ui:Label name="edit-move" class="mono debug-value" />
                        <ui:Button name="edit-move-up" class="btn small step" text="+" focusable="false" />
                    </ui:VisualElement>
                    <ui:VisualElement class="debug-row">
                        <ui:Button name="edit-set-ap" class="btn small" focusable="false"><ui:Label class="btn-text" text="Set AP and movement" /></ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="debug-row">
                        <ui:Button name="edit-spawn-prev" class="btn small step" text="&lt;" focusable="false" />
                        <ui:Label name="edit-spawn" class="mono debug-value wide" />
                        <ui:Button name="edit-spawn-next" class="btn small step" text="&gt;" focusable="false" />
                        <ui:Button name="edit-spawn-go" class="btn small" focusable="false"><ui:Label name="edit-spawn-go-text" class="btn-text" text="Spawn on a tile" /></ui:Button>
                    </ui:VisualElement>
                    <ui:Label class="debug-section display" text="WAVES AND FIGHT" />
                    <ui:VisualElement class="debug-row">
                        <ui:Button name="edit-force-wave" class="btn small" focusable="false"><ui:Label class="btn-text" text="Force next wave" /></ui:Button>
                        <ui:Button name="edit-hold-wave" class="btn small" focusable="false"><ui:Label class="btn-text" text="Hold back wave 3" /></ui:Button>
                        <ui:Button name="edit-restart" class="btn small" focusable="false"><ui:Label class="btn-text" text="Restart fight" /></ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="debug-replay" class="hidden">
                        <ui:Label class="debug-section display" text="SAVED FIGHT" />
                        <ui:VisualElement class="debug-row">
                            <ui:Button name="debug-replay-pause" class="btn small" focusable="false"><ui:Label name="debug-replay-pause-text" class="btn-text" text="Pause" /><ui:Label class="kbd mono" text="P" /></ui:Button>
                            <ui:Button name="debug-replay-step" class="btn small" focusable="false"><ui:Label class="btn-text" text="Step" /><ui:Label class="kbd mono" text="N" /></ui:Button>
                            <ui:Label name="debug-replay-at" class="faint mono debug-note" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView name="debug-text" class="debug-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="column-main" picking-mode="Ignore">
                <ui:VisualElement name="status" class="panel status">
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="HP" />
                        <ui:VisualElement name="hp-cells" class="cells" />
                        <ui:Label name="hp-text" class="value mono" />
                        <ui:VisualElement name="hp-pills" class="pills" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="AP" />
                        <ui:VisualElement name="ap-cells" class="cells" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="MOVE" />
                        <ui:VisualElement name="move-cells" class="cells" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="ROUND" />
                        <ui:Label name="round" class="value mono" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cell">
                        <ui:Label class="cell-label display" text="PHASE" />
                        <ui:Label name="phase" class="value small display" />
                    </ui:VisualElement>
                    <ui:Label name="incoming" class="incoming display" />
                </ui:VisualElement>

                <ui:VisualElement name="board-area" class="board-area" picking-mode="Ignore">
                    <ui:Label name="banner" class="banner display hidden" picking-mode="Ignore" />
                    <ui:Label name="alert" class="banner alert display hidden" picking-mode="Ignore" />
                    <ui:VisualElement name="opener" class="opener hidden" picking-mode="Ignore">
                        <ui:Label name="opener-title" class="opener-title display" picking-mode="Ignore" />
                        <ui:VisualElement class="opener-rule" picking-mode="Ignore" />
                        <ui:Label name="opener-sub" class="opener-sub display" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="panel action-panel">
                    <ui:VisualElement name="action-row" class="action-row" />
                    <ui:VisualElement class="controls">
                        <ui:Button name="undo" class="btn" focusable="false"><ui:Label class="btn-text" text="Undo move" /><ui:Label class="kbd mono" text="Z" /></ui:Button>
                        <ui:Button name="end-turn" class="btn primary" focusable="false"><ui:Label class="btn-text" text="End turn" /><ui:Label class="kbd mono" text="E" /></ui:Button>
                        <ui:Button name="skip" class="btn hidden" focusable="false"><ui:Label class="btn-text" text="Skip" /><ui:Label class="kbd mono" text="Space" /></ui:Button>
                        <ui:Label name="hint" class="hint" />
                        <ui:Label class="control-label display" text="SPEED" /><ui:Label class="kbd mono key-before" text="F" />
                        <ui:VisualElement class="seg">
                            <ui:Button name="speed-1" class="seg-btn" text="1x" focusable="false" />
                            <ui:Button name="speed-2" class="seg-btn" text="2x" focusable="false" />
                            <ui:Button name="speed-0" class="seg-btn" text="Skip" focusable="false" />
                        </ui:VisualElement>
                        <ui:Button name="intents" class="btn" focusable="false"><ui:Label class="btn-text" text="Intents" /><ui:Label class="kbd mono" text="I" /></ui:Button>
                        <ui:Button name="sound" class="btn" focusable="false"><ui:Label class="btn-text" text="Sound" /><ui:Label class="kbd mono" text="M" /></ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="column-side">
                <ui:VisualElement class="panel">
                    <ui:VisualElement class="panel-head">
                        <ui:VisualElement class="title-left"><ui:VisualElement class="led amber" /><ui:Label class="panel-title display" text="INTERCOM" /></ui:VisualElement>
                        <ui:Button name="open-log" class="btn small" focusable="false"><ui:Label class="btn-text" text="Log" /><ui:Label class="kbd mono" text="L" /></ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="intercom" class="intercom-text mono" />
                </ui:VisualElement>
                <ui:VisualElement class="panel">
                    <ui:VisualElement class="title-left"><ui:VisualElement class="led" /><ui:Label name="info-title" class="panel-title display" text="SCANNER" /></ui:VisualElement>
                    <ui:VisualElement name="info-body" class="info-body" />
                </ui:VisualElement>
                <ui:VisualElement class="panel">
                    <ui:VisualElement class="panel-head">
                        <ui:VisualElement class="title-left"><ui:VisualElement class="led" /><ui:Label class="panel-title display" text="MINIONS" /></ui:VisualElement>
                        <ui:Label name="minion-count" class="faint mono" />
                    </ui:VisualElement>
                    <ui:VisualElement name="minions" />
                </ui:VisualElement>
                <ui:VisualElement class="panel log-panel">
                    <ui:VisualElement class="title-left"><ui:VisualElement class="led" /><ui:Label class="panel-title display" text="COMBAT LOG" /></ui:VisualElement>
                    <ui:ScrollView name="log" class="log" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="toast" class="toast hidden" picking-mode="Ignore" />

        <ui:VisualElement name="title" class="fill overlay hidden">
            <ui:VisualElement class="title-card">
                <ui:VisualElement class="row title-kicker-row"><ui:VisualElement class="led red" /><ui:Label class="title-kicker display" text="CONTAINMENT BREACH" /></ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:Label class="title-logo display" text="LAB " />
                    <ui:Label class="title-logo accent display" text="ESCAPE" />
                </ui:VisualElement>
                <ui:Label name="title-room" class="title-sub display" />
                <ui:VisualElement name="title-terminal" class="terminal" />
                <ui:VisualElement class="row title-actions">
                    <ui:Button name="title-begin" class="btn primary big" focusable="false"><ui:Label class="btn-text" text="Begin" /><ui:Label class="kbd mono" text="Enter" /></ui:Button>
                    <ui:Label name="title-blurb" class="muted title-blurb" />
                </ui:VisualElement>
                <ui:Label name="title-foot" class="title-foot faint mono" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="start" class="fill overlay">
            <ui:VisualElement class="card">
                <ui:Label name="start-title" class="card-title display" />
                <ui:Label class="muted" text="Choose a loadout. Press its number, or click it." />
                <ui:VisualElement name="presets" class="presets" />
                <ui:Label name="start-error" class="warn hidden" />
                <ui:VisualElement name="recent-box" class="recent hidden">
                    <ui:Label class="recent-title display" text="WATCH A SAVED FIGHT" />
                    <ui:VisualElement name="recent" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="end" class="fill overlay hidden" picking-mode="Ignore">
            <ui:VisualElement name="end-card" class="card">
                <ui:Label name="end-title" class="card-title display" />
                <ui:VisualElement name="end-rule" class="end-rule" />
                <ui:Label name="end-cause" class="muted" />
                <ui:VisualElement name="end-figures" class="figures" />
                <ui:VisualElement class="row">
                    <ui:Button name="again" class="btn primary" focusable="false"><ui:Label class="btn-text" text="Fight again" /><ui:Label class="kbd mono" text="R" /></ui:Button>
                    <ui:Button name="change" class="btn" text="Change loadout" focusable="false" />
                </ui:VisualElement>
                <ui:Label name="end-saved" class="faint end-saved hidden" />
                <ui:VisualElement name="end-downloads" class="row downloads hidden">
                    <ui:Label class="faint" text="Save this fight's files:" />
                    <ui:Button name="download-replay" class="btn small" text="Replay" focusable="false" />
                    <ui:Button name="download-summary" class="btn small" text="Summary" focusable="false" />
                    <ui:Button name="download-events" class="btn small" text="Event stream" focusable="false" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="log-modal" class="fill overlay hidden">
            <ui:VisualElement class="card wide">
                <ui:VisualElement class="panel-head">
                    <ui:Label class="card-title small display" text="TRANSMISSION LOG" />
                    <ui:Button name="close-log" class="btn small" focusable="false"><ui:Label class="btn-text" text="Close" /><ui:Label class="kbd mono" text="Esc" /></ui:Button>
                </ui:VisualElement>
                <ui:ScrollView name="log-lines" class="modal-lines" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
