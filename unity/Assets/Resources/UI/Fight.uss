/* The fight HUD. Colours follow the web client's dark theme; every colour on the board is paired with a word or a shape. */
:root {
    --panel: rgba(14, 20, 24, 0.94);
    --panel-2: #131b20;
    --panel-3: #1a242a;
    --line: #22313a;
    --line-2: #34474f;
    --ink: #e1eae6;
    --ink-2: #97aaa5;
    --ink-3: #5f7277;
    --accent: #22c3a6;
    --amber: #ffb020;
    --danger: #ff4d3d;
    --good: #36d07a;
    --move: #3fe0c5;
    --chip: rgba(11, 17, 20, 0.92);
    color: var(--ink);
    font-size: 14px;
}

.hidden { display: none; }
.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.layout { flex-direction: row; padding: 10px; }
.column-main { flex-grow: 1; flex-shrink: 1; flex-basis: 0; margin-right: 10px; }
.column-side { width: 345px; flex-shrink: 0; }
.board-area { flex-grow: 1; align-items: center; justify-content: center; }

.panel {
    background-color: var(--panel);
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: var(--line);
    border-top-color: var(--line-2);
    border-radius: 4px;
    padding: 8px 10px;
    margin-bottom: 8px;
}
.panel-head { flex-direction: row; justify-content: space-between; align-items: center; }
/* The web client's terminal frame: a tick of accent at two corners, and an LED before the title. The panel's shade from top to
   bottom is a texture Hud makes, over its colour. */
.tick { position: absolute; width: 10px; height: 10px; border-color: var(--accent); opacity: 0.8; }
.tick.tl { left: -1px; top: -1px; border-top-width: 2px; border-left-width: 2px; border-top-left-radius: 4px; }
.tick.br { right: -1px; bottom: -1px; border-bottom-width: 2px; border-right-width: 2px; border-bottom-right-radius: 4px; }
.title-left { flex-direction: row; align-items: center; }
.led { width: 9px; height: 9px; margin: 0 7px 3px 0; border-radius: 2px; border-width: 1px; background-color: var(--move); border-color: rgba(63, 224, 197, 0.35); }
.led.red { background-color: var(--danger); border-color: rgba(255, 77, 61, 0.35); }
.led.amber { background-color: var(--amber); border-color: rgba(255, 176, 32, 0.35); }
.panel-title {
    color: var(--accent);
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    padding: 0;
    margin-bottom: 4px;
}
.muted { color: var(--ink-2); white-space: normal; }
.faint { color: var(--ink-3); }
.warn { color: var(--danger); white-space: normal; }
.row { flex-direction: row; }

/* Status strip */
.status { flex-direction: row; align-items: center; padding: 6px 10px; }
.cell { flex-direction: row; align-items: center; margin-right: 24px; }
.cell-label { color: var(--ink-3); font-size: 12px; -unity-font-style: bold; margin-right: 6px; padding: 0; }
.cells { flex-direction: row; }
.cell-pip { width: 13px; height: 16px; margin-right: 2px; background-color: var(--panel-3); border-width: 1px; border-color: var(--line-2); }
.cell-pip.hp { width: 10px; }
.cell-pip.full { background-color: var(--accent); border-color: var(--accent); }
.cell-pip.hp.full { background-color: var(--good); border-color: var(--good); }
.cell-pip.hp.full.low { background-color: var(--danger); border-color: var(--danger); }
/* HP just lost stays white for a moment before the cell empties, on the status strip and on the bars over the board. */
.cell-pip.hp.ghost { background-color: white; border-color: white; }
.value { font-size: 18px; -unity-font-style: bold; padding: 0; margin-left: 6px; }
.value.small { font-size: 14px; }
.pills { flex-direction: row; margin-left: 8px; }
.pill {
    font-size: 11px;
    -unity-font-style: bold;
    padding: 1px 5px;
    border-width: 1px;
    border-radius: 3px;
    margin-right: 3px;
    background-color: var(--chip);
}
.incoming { margin-left: auto; font-size: 14px; -unity-font-style: bold; color: var(--good); padding: 0; }
.incoming.bad { color: var(--amber); }
.incoming.lethal { color: var(--danger); }

/* Action bar */
.action-panel { margin-bottom: 0; }
.action-row { flex-direction: row; flex-wrap: wrap; margin-bottom: 6px; }
.action-btn {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 92px;
    max-width: 150px;
    height: 66px;
    /* A narrow bar (the debug overlay takes its room from the board area) cuts a long reason short instead of spilling it
       over the next row; the Scanner gives it in full. */
    overflow: hidden;
    margin: 0 4px 4px 0;
    padding: 4px 6px;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 3px;
    align-items: flex-start;
    justify-content: flex-start;
}
.action-btn:hover { background-color: var(--panel-3); }
/* A button centres its text, and labels inherit that; the action buttons' labels sit top left. */
.action-btn { -unity-text-align: upper-left; }
.action-btn.utility { border-left-color: var(--ink-3); border-left-width: 3px; }
.action-btn.tech { border-left-color: #3d9be0; border-left-width: 3px; }
.action-btn.alien { border-left-color: #1fc28a; border-left-width: 3px; }
.action-btn.selected { background-color: #16413c; border-color: var(--move); }
.action-btn:disabled, .action-btn.off { opacity: 0.55; }
.ab-top { flex-direction: row; justify-content: space-between; align-items: flex-start; width: 100%; flex-shrink: 0; }
.ab-name { font-size: 13px; -unity-font-style: bold; padding: 0; white-space: normal; flex-grow: 1; flex-shrink: 1; flex-basis: 0; -unity-text-align: upper-left; }
.ab-key { font-size: 10px; -unity-text-align: middle-center; color: var(--ink-2); min-width: 15px; padding: 0 3px; margin: 1px 0 0 4px; border-width: 1px; border-bottom-width: 2px; border-radius: 3px; border-color: var(--line-2); background-color: var(--chip); }
.ab-cost { font-size: 10px; color: var(--amber); padding: 0; white-space: normal; flex-shrink: 0; }

.controls { flex-direction: row; align-items: center; }
/* Keycaps, as the web client's kbd. A button with one holds its words and its key side by side. */
.btn { flex-direction: row; align-items: center; }
.btn-text { padding: 0; margin: 0; }
.kbd {
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-width: 17px;
    padding: 0 4px;
    margin: 0 0 0 7px;
    border-width: 1px;
    border-bottom-width: 2px;
    border-radius: 3px;
    border-color: var(--line-2);
    background-color: var(--chip);
    color: var(--ink-2);
}
.kbd.key-before { margin: 0 6px 0 0; }
.btn.primary .kbd { background-color: rgba(3, 32, 27, 0.18); border-color: rgba(3, 32, 27, 0.45); color: #03201b; }
.btn.small .kbd { font-size: 9px; min-width: 14px; padding: 0 3px; margin-left: 5px; }
.btn.off .btn-text { color: var(--ink-3); }
.btn {
    background-color: var(--panel-3);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 3px;
    color: var(--ink);
    padding: 5px 10px;
    margin: 0 6px 0 0;
    font-size: 13px;
}
.btn:hover { background-color: #24323a; }
.btn:disabled { opacity: 0.45; }
.btn.primary { background-color: var(--accent); border-color: var(--accent); color: #03201b; -unity-font-style: bold; }
.btn.primary:hover { background-color: var(--move); }
.btn.small { padding: 2px 7px; font-size: 11px; margin: 0; }
.btn.off { color: var(--ink-3); }
.hint { flex-grow: 1; flex-shrink: 1; flex-basis: 0; color: var(--ink-2); font-size: 12px; white-space: normal; padding: 0 8px; }
.control-label { color: var(--ink-3); font-size: 12px; padding: 0; margin-right: 5px; }
.seg { flex-direction: row; margin-right: 8px; }
.seg-btn {
    background-color: var(--panel-3);
    border-width: 1px;
    border-color: var(--line-2);
    color: var(--ink-2);
    margin: 0;
    padding: 5px 8px;
    border-radius: 0;
    font-size: 12px;
}
.seg-btn.on { background-color: var(--accent); color: #03201b; -unity-font-style: bold; }

/* Side column */
.intercom-text { color: var(--amber); white-space: normal; min-height: 54px; padding: 0; }
.info-body { min-height: 100px; }
.info-line { white-space: normal; padding: 1px 0; color: var(--ink); }
.info-line.head { -unity-font-style: bold; }
.info-line.muted { color: var(--ink-2); }
.info-line.warn { color: var(--danger); }
.minion-row { flex-direction: row; justify-content: space-between; padding: 1px 0; }
.log-panel { flex-grow: 1; flex-shrink: 1; flex-basis: 0; margin-bottom: 0; }
.log { flex-grow: 1; }
.log-line { font-size: 12px; white-space: normal; color: var(--ink-2); padding: 1px 0; }
.log-line.round { color: var(--accent); -unity-font-style: bold; margin-top: 4px; }
.log-line.phase { color: var(--ink-3); }
.log-line.ff { color: var(--danger); }
.log-line.hazard { color: var(--amber); }
.log-line.intercom { color: var(--amber); }
.log-line.end { color: var(--ink); -unity-font-style: bold; }
.log-line.debug { color: #b58cff; }

/* The debug overlay: a column of its own on the left, so it covers none of the board. */
.column-debug { width: 330px; flex-shrink: 0; margin-right: 10px; }
.debug-panel { flex-grow: 1; margin-bottom: 0; }
.debug-version { font-size: 11px; white-space: normal; padding: 0; margin-bottom: 4px; }
.debug-content { font-size: 11px; white-space: normal; padding: 0; margin-bottom: 4px; color: var(--ink-2); }
.debug-content.error { color: var(--danger); }
.debug-section { color: var(--amber); font-size: 12px; letter-spacing: 1px; -unity-font-style: bold; padding: 0; margin: 8px 0 3px 0; }
.debug-section.face { font-size: 15px; }
.debug-toggles { margin-right: 0; }
.debug-toggles .seg-btn { padding: 3px 7px; font-size: 11px; }
.debug-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 4px; }
.debug-name { font-size: 11px; padding: 0; margin: 0 5px 0 0; min-width: 24px; }
.debug-value { font-size: 12px; padding: 0; margin: 0 5px; min-width: 22px; -unity-text-align: middle-center; color: var(--ink); }
.debug-value.wide { min-width: 130px; }
.btn.small.step { min-width: 22px; padding: 2px 4px; -unity-text-align: middle-center; }

.debug-row .btn.small { margin-right: 5px; }
.btn.on { background-color: #16413c; border-color: var(--move); }
.debug-note { font-size: 11px; padding: 0; }
.debug-text { flex-grow: 1; flex-shrink: 1; margin-top: 2px; }
.debug-line { font-size: 12px; white-space: normal; padding: 1px 0; color: var(--ink); }
.debug-line.section { color: var(--amber); font-size: 12px; letter-spacing: 1px; -unity-font-style: bold; margin-top: 8px; }
.debug-line.head { -unity-font-style: bold; }
.debug-line.muted { color: var(--ink-2); }
.debug-line.faint { color: var(--ink-3); font-size: 11px; }
.debug-line.section.face { font-size: 15px; }

/* Banners and flashes */
.banner {
    position: absolute;
    top: 1%;
    padding: 5px 40px;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--ink);
    background-color: rgba(7, 10, 12, 0.82);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--accent);
}
.banner.minion { border-color: #56b4e9; }
.banner.enemy { border-color: #ff6b1f; color: #ffc9a8; }
.banner.environment { border-color: var(--amber); color: #ffe1a3; }
.banner.alert { top: 9%; border-color: var(--danger); color: var(--danger); }
/* The fight's title, set down over the board as the lights come on. */
.opener { position: absolute; top: 24%; align-items: center; padding: 14px 46px 16px 46px; background-color: rgba(4, 6, 8, 0.66); border-top-width: 2px; border-bottom-width: 2px; border-color: var(--danger); }
.opener-title { font-size: 58px; -unity-font-style: bold; letter-spacing: 9px; color: var(--ink); padding: 0; margin: 0; -unity-text-outline-width: 1px; -unity-text-outline-color: #06090b; }
.opener-rule { height: 3px; width: 100%; background-color: var(--danger); margin: 6px 0 8px 0; }
.opener-sub { font-size: 19px; -unity-font-style: bold; letter-spacing: 6px; color: var(--danger); padding: 0; margin: 0; }
.vignette { position: absolute; left: 0; top: 0; width: 100%; height: 100%; -unity-background-scale-mode: stretch-to-fill; }
/* The alarm and a blow to the player light the board's edges from inside, as the web client's inset glows do. Hud places them
   over the board and gives them a glow made in code; the slices keep its width the same on every side. */
.board-overlay { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.flash {
    opacity: 0;
    transition-property: opacity;
    transition-timing-function: ease-out;
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 1.7px;
}
.flash.on { opacity: 1; transition-duration: 0s; }
.alarm { transition-duration: 1s; -unity-background-image-tint-color: rgb(255, 140, 20); }
.hurt { transition-duration: 0.6s; -unity-background-image-tint-color: rgb(255, 30, 20); }
.toast {
    position: absolute;
    bottom: 146px;
    left: 30%;
    right: 40%;
    -unity-text-align: middle-center;
    background-color: var(--chip);
    color: var(--ink);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 3px;
    padding: 6px 12px;
    white-space: normal;
}

/* Overlays */
.overlay { align-items: center; justify-content: center; background-color: rgba(3, 5, 6, 0.72); }
.card {
    background-color: var(--panel-2);
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 5px;
    padding: 22px 28px;
    width: 600px;
}
.card.wide { width: 720px; height: 70%; }
.card-title { font-size: 34px; -unity-font-style: bold; letter-spacing: 2px; color: var(--ink); padding: 0; margin-bottom: 6px; }
.card-title.small { font-size: 22px; }
.card-title.win { color: var(--good); }
.card-title.lose { color: var(--danger); }
.card .muted { margin-bottom: 14px; }
/* The end card: a rule under the title in its colour, then the fight in four figures. */
.end-rule { height: 3px; width: 100%; margin: 2px 0 10px 0; background-color: var(--good); }
.end-rule.lose { background-color: var(--danger); }
.figures { flex-direction: row; margin: 0 0 18px 0; }
.figure { flex-grow: 1; flex-basis: 0; padding: 0 10px; border-left-width: 2px; border-color: var(--line-2); }
.figure-value { font-size: 30px; -unity-font-style: bold; color: var(--ink); padding: 0; }
.figure-label { font-size: 12px; color: var(--ink-3); padding: 0; letter-spacing: 1px; }
.figure-note { font-size: 11px; color: var(--danger); padding: 0; white-space: normal; }
.figure-label.face { font-size: 14px; }
.presets { margin-top: 2px; }
.preset-btn {
    background-color: var(--panel-3);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 3px;
    padding: 10px 12px;
    margin: 0 0 8px 0;
    align-items: flex-start;
}
.preset-btn:hover { border-color: var(--accent); }
.preset-name { font-size: 18px; -unity-font-style: bold; padding: 0; }
.preset-kit { color: var(--ink-2); font-size: 12px; white-space: normal; padding: 0; }
.modal-lines { flex-grow: 1; margin-top: 8px; }
/* Saved fights on the start screen, and where the end card says a fight was saved. */
.recent { margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-color: var(--line); }
.recent-title { color: var(--accent); font-size: 13px; letter-spacing: 1px; padding: 0; margin-bottom: 6px; }
.recent-title.face { font-size: 16px; }
.recent-btn { background-color: var(--panel-3); border-width: 1px; border-color: var(--line-2); border-radius: 3px; padding: 5px 10px; margin: 0 0 4px 0; -unity-text-align: middle-left; font-size: 12px; color: var(--ink-2); }
.recent-btn:hover { border-color: var(--accent); color: var(--ink); }
.end-saved { margin-top: 12px; font-size: 11px; white-space: normal; padding: 0; }
.downloads { margin-top: 12px; align-items: center; }
.downloads .btn.small { margin-left: 6px; }
.modal-line { color: var(--amber); padding: 6px 0; border-top-width: 1px; border-color: var(--line); white-space: normal; }

/* Tags anchored to the board. Each anchor is a zero-sized point; its row hangs off that point. */
.anchor { position: absolute; left: 0; top: 0; width: 0; height: 0; }
/* The board's coordinates, centred on their point beside the near edges. */
.coord { position: absolute; left: -20px; width: 40px; top: -10px; height: 20px; padding: 0; -unity-text-align: middle-center; font-size: 15px; color: var(--ink-2); letter-spacing: 1px; }
.feet-row { position: absolute; left: -44px; width: 88px; top: 8px; flex-direction: row; justify-content: center; align-items: center; }
.hp-bar { flex-direction: row; width: 46px; height: 6px; background-color: var(--chip); border-width: 1px; border-color: #06090b; }
.hp-seg { flex-grow: 1; flex-basis: 0; margin-right: 1px; background-color: #2a3338; }
.hp-seg.full { background-color: var(--good); }
.hp-seg.full.low { background-color: var(--danger); }
.hp-seg.ghost { background-color: white; }
.hp-fill { height: 100%; background-color: var(--good); }
.hp-fill.low { background-color: var(--danger); }
.hp-fill.ghost { background-color: white; }
.hp-number { font-size: 13px; -unity-font-style: bold; color: var(--ink); padding: 0; margin-left: 4px; -unity-text-outline-width: 1px; -unity-text-outline-color: #06090b; }
.head-row { position: absolute; left: -90px; width: 180px; bottom: 2px; flex-direction: row; justify-content: center; align-items: flex-end; flex-wrap: wrap; }
.tag-chip {
    font-size: 11px;
    -unity-font-style: bold;
    padding: 0 4px;
    margin: 1px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--line-2);
    background-color: var(--chip);
    color: var(--ink);
}
.tag-pips { flex-direction: row; margin: 1px; }
.tag-pip { width: 5px; height: 9px; margin-right: 1px; background-color: var(--chip); border-width: 1px; border-color: #06090b; }
.tag-pip.ammo { background-color: #e8c35a; }
.tag-pip.charge { background-color: #f0e442; }
.badge-row { position: absolute; left: -90px; width: 180px; bottom: 0; flex-direction: row; justify-content: center; }
.badge { font-size: 13px; -unity-font-style: bold; color: white; padding: 1px 5px; margin-right: 2px; border-width: 1px; border-radius: 3px; border-color: #06090b; }
.badge.damage { background-color: #d9392c; }
.badge.none { background-color: #5f7277; }
.badge.heal { background-color: #1b9c5c; }
.badge.ko { background-color: var(--ink); color: #070a0c; }
.badge.status { background-color: #39505a; }
.badge.friendly { background-color: var(--danger); }
.incoming-chip {
    position: absolute;
    left: -56px;
    bottom: 10px;
    padding: 0 4px;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--danger);
    background-color: var(--chip);
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--danger);
    white-space: nowrap;
}
.incoming-chip.faint { opacity: 0.6; }
.dies-chip { position: absolute; left: 12px; bottom: 16px; font-size: 18px; -unity-font-style: bold; color: var(--danger); padding: 0; -unity-text-outline-width: 1px; -unity-text-outline-color: #06090b; }
/* The debug overlay's marks on the board: unit IDs in a unit's row, and labels on tiles, each centred on its point. */
.tag-chip.debug-id { color: #b58cff; border-color: #b58cff; }
.debug-mark { position: absolute; left: -40px; width: 80px; top: -8px; height: 16px; padding: 0; -unity-text-align: middle-center; font-size: 11px; -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: #06090b; }
.debug-mark.debug-spawn { color: #ff6b1f; }
.debug-mark.debug-hazard { color: var(--amber); }
.debug-mark.debug-hazard.primed { color: var(--danger); }
.debug-mark.debug-score { color: var(--danger); font-size: 12px; }
.debug-mark.debug-score.low { color: var(--ink-3); }
.float-text { position: absolute; -unity-font-style: bold; -unity-text-outline-width: 1.5px; -unity-text-outline-color: #0b0f12; padding: 0; white-space: nowrap; }

/* The web client's faces, from the system (Fonts.cs). An element with the face it asked for has the class `face`: the condensed
   display face is set larger, and its spacing opened up, as the web client sets it. Without it, the sizes above stand. */
.panel-title.face { font-size: 17px; letter-spacing: 2px; }
.cell-label.face { font-size: 15px; letter-spacing: 1px; }
.value.small.face { font-size: 19px; letter-spacing: 1px; }
.incoming.face { font-size: 18px; letter-spacing: 1px; }
.banner.face { font-size: 36px; letter-spacing: 5px; padding: 6px 44px 3px 44px; }
.opener-title.face { font-size: 78px; letter-spacing: 10px; }
.opener-sub.face { font-size: 25px; letter-spacing: 7px; }
.card-title.face { font-size: 50px; letter-spacing: 4px; }
.card-title.small.face { font-size: 26px; letter-spacing: 2px; }
.ab-name.face { font-size: 16px; letter-spacing: 0.5px; }
.preset-name.face { font-size: 25px; letter-spacing: 2px; }
.control-label.face { font-size: 14px; letter-spacing: 1px; }
.coord.face { font-size: 19px; }
.log-line.face { font-size: 11px; }
.intercom-text.face { font-size: 13px; }

/* The title screen: the web client's, without its art. */
.title-card { width: 700px; padding: 34px 42px; background-color: rgba(10, 14, 16, 0.96); border-width: 1px; border-color: var(--line-2); border-radius: 5px; }
.title-kicker-row { align-items: center; margin-bottom: 4px; }
.title-kicker { color: var(--danger); font-size: 13px; letter-spacing: 3px; padding: 0 0 0 8px; }
.title-kicker.face { font-size: 16px; }
.title-logo { font-size: 58px; -unity-font-style: bold; letter-spacing: 3px; color: var(--ink); padding: 0; }
.title-logo.accent { color: var(--accent); }
.title-logo.face { font-size: 78px; letter-spacing: 5px; }
.title-sub { font-size: 16px; letter-spacing: 3px; color: var(--ink-2); padding: 0; margin-bottom: 10px; }
.terminal { background-color: #060909; border-width: 1px; border-color: var(--line); border-radius: 3px; padding: 10px 14px; margin: 8px 0 18px 0; min-height: 124px; }
.terminal-line { font-size: 14px; color: var(--accent); padding: 0; white-space: pre; min-height: 20px; }
.terminal-line.alert { color: var(--amber); }
.title-actions { align-items: center; }
.title-blurb { font-size: 13px; margin: 0 0 0 18px; flex-shrink: 1; flex-grow: 1; flex-basis: 0; }
.title-foot { font-size: 11px; padding: 0; margin-top: 18px; white-space: normal; }
.btn.big { padding: 9px 22px; font-size: 16px; }
